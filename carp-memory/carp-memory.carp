;; Loaded by carp-compiler after types, specialization, and ownership. Keeping
;; the dependency edge there avoids reloading the compiler graph for clients
;; such as carp-session.

(doc OwnershipAllocationFact "is an experimental allocation-site obligation
retaining the low-level dimensions needed by later allocator selection and
resource accounting. `allocator` is a fresh symbolic provenance variable, not
a claim about the current CARP_MALLOC implementation. Symbolic layout strings
are target-independent facts awaiting the C ABI layout pass.")
(deftype OwnershipAllocationFact
  [site OwnershipSite
   resource OwnershipResource
   operation String
   allocator String
   region String
   element-type String
   element-count (Maybe Int)
   byte-extent String
   alignment String
   address-space String
   mobility String
   failure String
   reclamation String
   logical-account String
   physical-account String
   evidence String
   span (Maybe SourceSpan)])

(doc MemoryAnalysis "derives backend-neutral memory obligations from
specialized Core. It deliberately reports only facts justified by the current
IR and primitive manifests; allocator selection and target layout remain later
interpretations.")
(defmodule MemoryAnalysis
  (private array-element-name)
  (hidden array-element-name)
  (sig array-element-name (Fn [(Ref MonoType)] (Maybe String)))
  (defn array-element-name [type]
    (match-ref type
      (MonoType.Named type-name arguments)
        (if (and (String.= type-name "Array")
                 (Int.> (Array.length arguments) 0))
          (Maybe.Just
            (Type.render (Box.peek (Array.unsafe-nth arguments 0))))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private literal-int)
  (hidden literal-int)
  (defn literal-int [expression]
    (match-ref expression
      (SpecializedExpr.IntLit _ _ value) (Maybe.Just @value)
      _ (Maybe.Nothing)))

  (private allocation-fact)
  (hidden allocation-fact)
  (defn allocation-fact [context id operation element count name provenance]
    (let [extent (match-ref count
                   (Maybe.Just n)
                     (String.concat
                       &[(Int.str @n) @" * sizeof(" (String.copy element) @")"])
                   (Maybe.Nothing)
                     (String.concat
                       &[@"count * sizeof(" (String.copy element) @")"]))]
      (OwnershipAllocationFact.init
        (OwnershipSite.init context id)
        (OwnershipResource.Temporary id)
        (String.copy operation)
        (String.concat &[@"alpha:" (Int.str context)])
        (String.concat &[@"function:" (String.copy name)])
        (String.copy element)
        @count
        extent
        (String.concat &[@"alignof(" (String.copy element) @")"])
        (String.copy "unresolved")
        (String.copy "stable-until-resize-or-free")
        (String.copy "unresolved-CARP_MALLOC-policy")
        (String.copy "individual-logical; physical-unresolved")
        (String.copy "memory.logical.live")
        (String.copy "memory.physical.requested")
        (String.copy "lowering-checked")
        (CoreProvenance.node-span provenance id))))

  (private collect-allocation-facts!)
  (hidden collect-allocation-facts!)
  (private collect-allocation-facts-array!)
  (hidden collect-allocation-facts-array!)
  (private collect-allocation-facts-branches!)
  (hidden collect-allocation-facts-branches!)
  (sig collect-allocation-facts!
       (Fn [(Ref SpecializedExpr) Int (Ref String) (Ref CoreProvenance)
            (Ref (Array OwnershipAllocationFact))] ()))
  (sig collect-allocation-facts-array!
       (Fn [(Ref (Array (Box SpecializedExpr))) Int (Ref String)
            (Ref CoreProvenance) (Ref (Array OwnershipAllocationFact))] ()))
  (sig collect-allocation-facts-branches!
       (Fn [(Ref (Array SpecializedMatchBranch)) Int (Ref String)
            (Ref CoreProvenance) (Ref (Array OwnershipAllocationFact))] ()))

  (defn collect-allocation-facts-array! [expressions context name provenance facts]
    (for [i 0 (Array.length expressions)]
      (collect-allocation-facts!
        (Box.peek (Array.unsafe-nth expressions i))
        context name provenance facts)))

  (defn collect-allocation-facts-branches! [branches context name provenance facts]
    (for [i 0 (Array.length branches)]
      (collect-allocation-facts!
        (Box.peek (SpecializedMatchBranch.body
                    (Array.unsafe-nth branches i)))
        context name provenance facts)))

  (defn collect-allocation-facts! [expression context name provenance facts]
    (match-ref expression
      (SpecializedExpr.ArrayLit id type elements)
        (do
          ;; The C99 backend emits NULL for an empty literal, not malloc(0).
          (when-do (Int.> (Array.length elements) 0)
            (match (array-element-name (Box.peek type))
              (Maybe.Just element)
                (Array.push-back! facts
                  (allocation-fact context @id "array-literal" &element
                                   &(Maybe.Just (Array.length elements))
                                   name provenance))
              (Maybe.Nothing) ()))
          (collect-allocation-facts-array! elements context name provenance facts))
      (SpecializedExpr.GlobalCall id type reference _ _ arguments)
        (do
          ;; The registry manifest identifies allocate/Array.allocate without
          ;; coupling this analysis to stable resolver IDs. The current extent
          ;; vocabulary also tells us which argument carries the element count.
          (match (PrimitiveRegistry.memory-for reference)
            (Maybe.Just manifest)
              (let [effects (PrimitiveMemoryManifest.effects &manifest)]
                (for [effect-index 0 (Array.length effects)]
                  (match-ref (Array.unsafe-nth effects effect-index)
                    (PrimitiveMemoryEffect.Allocate extent)
                      (match-ref extent
                        (PrimitiveMemoryExtent.ArgumentElements argument-index)
                          (match (array-element-name (Box.peek type))
                            (Maybe.Just element)
                              (let [count (if
                                  (Int.< @argument-index (Array.length arguments))
                                  (literal-int
                                    (Box.peek
                                      (Array.unsafe-nth arguments
                                                        @argument-index)))
                                  (the (Maybe Int) (Maybe.Nothing)))]
                                (match-ref &count
                                  (Maybe.Just n)
                                    (when-do (Int.> @n 0)
                                      (Array.push-back! facts
                                        (allocation-fact
                                          context @id "array-allocate" &element
                                          &count name provenance)))
                                  (Maybe.Nothing)
                                    (Array.push-back! facts
                                      (allocation-fact
                                        context @id
                                        "array-allocate-if-nonzero"
                                        &element &count name provenance))))
                            (Maybe.Nothing) ())
                        _ ())
                    _ ())))
            (Maybe.Nothing) ())
          (collect-allocation-facts-array! arguments context name provenance facts))
      (SpecializedExpr.Call _ _ callee arguments)
        (do
          (collect-allocation-facts! (Box.peek callee)
                                     context name provenance facts)
          (collect-allocation-facts-array! arguments context name provenance facts))
      (SpecializedExpr.Do _ _ expressions)
        (collect-allocation-facts-array! expressions context name provenance facts)
      (SpecializedExpr.If _ _ condition then-branch else-branch)
        (do
          (collect-allocation-facts! (Box.peek condition)
                                     context name provenance facts)
          (collect-allocation-facts! (Box.peek then-branch)
                                     context name provenance facts)
          (collect-allocation-facts! (Box.peek else-branch)
                                     context name provenance facts))
      (SpecializedExpr.Let _ _ _ value body)
        (do
          (collect-allocation-facts! (Box.peek value)
                                     context name provenance facts)
          (collect-allocation-facts! (Box.peek body)
                                     context name provenance facts))
      (SpecializedExpr.Set _ _ _ value)
        (collect-allocation-facts! (Box.peek value)
                                   context name provenance facts)
      (SpecializedExpr.While _ _ condition body)
        (do
          (collect-allocation-facts! (Box.peek condition)
                                     context name provenance facts)
          (collect-allocation-facts! (Box.peek body)
                                     context name provenance facts))
      (SpecializedExpr.Lambda _ _ _ body)
        ;; Closure environments are deliberately deferred: allocation depends
        ;; on capture/lifting facts which this pre-lowering tree does not state.
        (collect-allocation-facts! (Box.peek body)
                                   context name provenance facts)
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (do
          (collect-allocation-facts! (Box.peek scrutinee)
                                     context name provenance facts)
          (collect-allocation-facts-branches! branches
                                              context name provenance facts))
      (SpecializedExpr.Annotation _ _ inner _)
        (collect-allocation-facts! (Box.peek inner)
                                   context name provenance facts)
      (SpecializedExpr.StaticArrayLit _ _ elements)
        (collect-allocation-facts-array! elements context name provenance facts)
      _ ()))

  (doc target-allocation-facts "returns allocation obligations in every
specialization body matching `target`. Primitive sites are interpreted through
the registry manifest, not through resolver IDs or generated C spelling.")
  (defn target-allocation-facts [specialized provenance target name]
    (let-do [facts (the (Array OwnershipAllocationFact) [])
             bodies (SpecializationModule.bodies specialized)]
      (for [i 0 (Array.length bodies)]
        (let [body (Array.unsafe-nth bodies i)]
          (when (CoreIR.same-ref?
                  (Specialization.reference
                    (SpecializedBody.specialization body))
                  target)
            (collect-allocation-facts! (Box.peek (SpecializedBody.body body))
                                       i name provenance &facts))))
      facts)))
