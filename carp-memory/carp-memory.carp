;; Loaded by carp-compiler after types, specialization, and ownership. Keeping
;; the dependency edge there avoids reloading the compiler graph for clients
;; such as carp-session.

(doc OwnershipAllocationFact "is an experimental allocation-site obligation
retaining the low-level dimensions needed by later allocator selection and
resource accounting. `allocator` is a fresh symbolic provenance variable, not
a claim about the current CARP_MALLOC implementation. Symbolic layout strings
are target-independent facts awaiting the C ABI layout pass.")
(deftype OwnershipAllocationFact
  [site OwnershipSite
   resource OwnershipResource
   operation String
   allocator String
   region String
   element-type String
   element-count (Maybe Int)
   byte-extent String
   alignment String
   address-space String
   mobility String
   failure String
   reclamation String
   logical-account String
   physical-account String
   evidence String
   span (Maybe SourceSpan)])

(doc MemoryEffectSite "attaches one direct memory effect to the specialized
expression that causes it. The primitive effect retains call-argument extent
information; `source` identifies an IR construct or resolved primitive.")
(deftype MemoryEffectSite
  [site OwnershipSite
   effect CoreMemoryEffect
   source String
   span (Maybe SourceSpan)])

(doc MemoryCallEdge "is a statically resolved edge between specialized bodies.
`target` indexes `SpecializationModule.bodies`, making cycles explicit without
building a recursive value graph.")
(deftype MemoryCallEdge
  [site OwnershipSite
   target Int
   callee String
   span (Maybe SourceSpan)])

(doc MemoryUnresolvedLeaf "prevents a closed-system memory proof. Current
reasons include indirect calls, unannotated foreign/template calls, and
explicitly unknown primitive manifests.")
(deftype MemoryUnresolvedLeaf
  [site OwnershipSite
   callee String
   reason String
   span (Maybe SourceSpan)])

(doc SpecializedMemorySummary "is the least fixed-point memory summary for one
specialized body. The four flags are independent: `frees` does not imply
`allocates`, while `unknown` prevents both noalloc and no-memory-effect proofs.
`effects` contains only direct sites; transitive provenance is retained by
`calls` instead of copying callee sites into every caller.")
(deftype SpecializedMemorySummary
  [specialization Specialization
   effects (Array MemoryEffectSite)
   calls (Array MemoryCallEdge)
   unresolved (Array MemoryUnresolvedLeaf)
   allocates Bool
   resizes Bool
   frees Bool
   unknown Bool])

(doc MemoryAnalysis "derives backend-neutral memory obligations from
specialized Core. It deliberately reports only facts justified by the current
IR and primitive manifests; allocator selection and target layout remain later
interpretations.")
(defmodule MemoryAnalysis
  (private array-element-name)
  (hidden array-element-name)
  (sig array-element-name (Fn [(Ref MonoType)] (Maybe String)))
  (defn array-element-name [type]
    (match-ref type
      (MonoType.Named type-name arguments)
        (if (and (String.= type-name "Array")
                 (Int.> (Array.length arguments) 0))
          (Maybe.Just
            (Type.render (Box.peek (Array.unsafe-nth arguments 0))))
          (Maybe.Nothing))
      _ (Maybe.Nothing)))

  (private literal-int)
  (hidden literal-int)
  (defn literal-int [expression]
    (match-ref expression
      (SpecializedExpr.IntLit _ _ value) (Maybe.Just @value)
      _ (Maybe.Nothing)))

  (private allocation-fact)
  (hidden allocation-fact)
  (defn allocation-fact [context id operation element count name provenance]
    (let [extent (match-ref count
                   (Maybe.Just n)
                     (String.concat
                       &[(Int.str @n) @" * sizeof(" (String.copy element) @")"])
                   (Maybe.Nothing)
                     (String.concat
                       &[@"count * sizeof(" (String.copy element) @")"]))]
      (OwnershipAllocationFact.init
        (OwnershipSite.init context id)
        (OwnershipResource.Temporary id)
        (String.copy operation)
        (String.concat &[@"alpha:" (Int.str context)])
        (String.concat &[@"function:" (String.copy name)])
        (String.copy element)
        @count
        extent
        (String.concat &[@"alignof(" (String.copy element) @")"])
        (String.copy "unresolved")
        (String.copy "stable-until-resize-or-free")
        (String.copy "unresolved-CARP_MALLOC-policy")
        (String.copy "individual-logical; physical-unresolved")
        (String.copy "memory.logical.live")
        (String.copy "memory.physical.requested")
        (String.copy "lowering-checked")
        (CoreProvenance.node-span provenance id))))

  (private collect-allocation-facts!)
  (hidden collect-allocation-facts!)
  (private collect-allocation-facts-array!)
  (hidden collect-allocation-facts-array!)
  (private collect-allocation-facts-branches!)
  (hidden collect-allocation-facts-branches!)
  (sig collect-allocation-facts!
       (Fn [(Ref SpecializedExpr) Int (Ref String) (Ref CoreProvenance)
            (Ref (Array OwnershipAllocationFact))] ()))
  (sig collect-allocation-facts-array!
       (Fn [(Ref (Array (Box SpecializedExpr))) Int (Ref String)
            (Ref CoreProvenance) (Ref (Array OwnershipAllocationFact))] ()))
  (sig collect-allocation-facts-branches!
       (Fn [(Ref (Array SpecializedMatchBranch)) Int (Ref String)
            (Ref CoreProvenance) (Ref (Array OwnershipAllocationFact))] ()))

  (defn collect-allocation-facts-array! [expressions context name provenance facts]
    (for [i 0 (Array.length expressions)]
      (collect-allocation-facts!
        (Box.peek (Array.unsafe-nth expressions i))
        context name provenance facts)))

  (defn collect-allocation-facts-branches! [branches context name provenance facts]
    (for [i 0 (Array.length branches)]
      (collect-allocation-facts!
        (Box.peek (SpecializedMatchBranch.body
                    (Array.unsafe-nth branches i)))
        context name provenance facts)))

  (defn collect-allocation-facts! [expression context name provenance facts]
    (match-ref expression
      (SpecializedExpr.ArrayLit id type elements)
        (do
          ;; The C99 backend emits NULL for an empty literal, not malloc(0).
          (when-do (Int.> (Array.length elements) 0)
            (match (array-element-name (Box.peek type))
              (Maybe.Just element)
                (Array.push-back! facts
                  (allocation-fact context @id "array-literal" &element
                                   &(Maybe.Just (Array.length elements))
                                   name provenance))
              (Maybe.Nothing) ()))
          (collect-allocation-facts-array! elements context name provenance facts))
      (SpecializedExpr.GlobalCall id type reference _ _ arguments)
        (do
          ;; The registry manifest identifies allocate/Array.allocate without
          ;; coupling this analysis to stable resolver IDs. The current extent
          ;; vocabulary also tells us which argument carries the element count.
          (match (PrimitiveRegistry.memory-for reference)
            (Maybe.Just manifest)
              (let [effects (CoreMemoryManifest.effects &manifest)]
                (for [effect-index 0 (Array.length effects)]
                  (match-ref (Array.unsafe-nth effects effect-index)
                    (CoreMemoryEffect.Allocate extent)
                      (match-ref extent
                        (CoreMemoryExtent.ArgumentElements argument-index)
                          (match (array-element-name (Box.peek type))
                            (Maybe.Just element)
                              (let [count (if
                                  (Int.< @argument-index (Array.length arguments))
                                  (literal-int
                                    (Box.peek
                                      (Array.unsafe-nth arguments
                                                        @argument-index)))
                                  (the (Maybe Int) (Maybe.Nothing)))]
                                (match-ref &count
                                  (Maybe.Just n)
                                    (when-do (Int.> @n 0)
                                      (Array.push-back! facts
                                        (allocation-fact
                                          context @id "array-allocate" &element
                                          &count name provenance)))
                                  (Maybe.Nothing)
                                    (Array.push-back! facts
                                      (allocation-fact
                                        context @id
                                        "array-allocate-if-nonzero"
                                        &element &count name provenance))))
                            (Maybe.Nothing) ())
                        _ ())
                    _ ())))
            (Maybe.Nothing) ())
          (collect-allocation-facts-array! arguments context name provenance facts))
      (SpecializedExpr.Call _ _ callee arguments)
        (do
          (collect-allocation-facts! (Box.peek callee)
                                     context name provenance facts)
          (collect-allocation-facts-array! arguments context name provenance facts))
      (SpecializedExpr.Do _ _ expressions)
        (collect-allocation-facts-array! expressions context name provenance facts)
      (SpecializedExpr.If _ _ condition then-branch else-branch)
        (do
          (collect-allocation-facts! (Box.peek condition)
                                     context name provenance facts)
          (collect-allocation-facts! (Box.peek then-branch)
                                     context name provenance facts)
          (collect-allocation-facts! (Box.peek else-branch)
                                     context name provenance facts))
      (SpecializedExpr.Let _ _ _ value body)
        (do
          (collect-allocation-facts! (Box.peek value)
                                     context name provenance facts)
          (collect-allocation-facts! (Box.peek body)
                                     context name provenance facts))
      (SpecializedExpr.Set _ _ _ value)
        (collect-allocation-facts! (Box.peek value)
                                   context name provenance facts)
      (SpecializedExpr.While _ _ condition body)
        (do
          (collect-allocation-facts! (Box.peek condition)
                                     context name provenance facts)
          (collect-allocation-facts! (Box.peek body)
                                     context name provenance facts))
      (SpecializedExpr.Lambda _ _ _ body)
        ;; Closure environments are deliberately deferred: allocation depends
        ;; on capture/lifting facts which this pre-lowering tree does not state.
        (collect-allocation-facts! (Box.peek body)
                                   context name provenance facts)
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (do
          (collect-allocation-facts! (Box.peek scrutinee)
                                     context name provenance facts)
          (collect-allocation-facts-branches! branches
                                              context name provenance facts))
      (SpecializedExpr.Annotation _ _ inner _)
        (collect-allocation-facts! (Box.peek inner)
                                   context name provenance facts)
      (SpecializedExpr.StaticArrayLit _ _ elements)
        (collect-allocation-facts-array! elements context name provenance facts)
      _ ()))

  (doc target-allocation-facts "returns allocation obligations in every
specialization body matching `target`. Primitive sites are interpreted through
the registry manifest, not through resolver IDs or generated C spelling.")
  (defn target-allocation-facts [specialized provenance target name]
    (let-do [facts (the (Array OwnershipAllocationFact) [])
             bodies (SpecializationModule.bodies specialized)]
      (for [i 0 (Array.length bodies)]
        (let [body (Array.unsafe-nth bodies i)]
          (when (CoreIR.same-ref?
                  (Specialization.reference
                    (SpecializedBody.specialization body))
                  target)
            (collect-allocation-facts! (Box.peek (SpecializedBody.body body))
                                       i name provenance &facts))))
      facts))

  (private summary-body-index)
  (hidden summary-body-index)
  (defn summary-body-index [bodies reference signature]
    (let-do [found -1]
      (for [i 0 (Array.length bodies)]
        (let [specialization (SpecializedBody.specialization
                               (Array.unsafe-nth bodies i))]
          (when (and
              (CoreIR.same-ref? (Specialization.reference specialization)
                                reference)
              (Type.same-representation?
                (Box.peek (Specialization.signature specialization))
                signature))
            (set! found i))))
      found))

  (private append-effect-site!)
  (hidden append-effect-site!)
  (defn append-effect-site! [effects effect context id source provenance]
    (Array.push-back! effects
      (MemoryEffectSite.init
        (OwnershipSite.init context id)
        (CoreMemoryEffect.copy effect)
        (String.copy source)
        (CoreProvenance.node-span provenance id))))

  (private append-unresolved!)
  (hidden append-unresolved!)
  (defn append-unresolved! [unresolved context id callee reason provenance]
    (Array.push-back! unresolved
      (MemoryUnresolvedLeaf.init
        (OwnershipSite.init context id)
        (String.copy callee)
        (String.copy reason)
        (CoreProvenance.node-span provenance id))))

  (private append-manifest!)
  (hidden append-manifest!)
  (defn append-manifest! [manifest context id source unknown-reason
                          provenance effects unresolved]
    (let [declared (CoreMemoryManifest.effects manifest)]
      (for [i 0 (Array.length declared)]
        (let [effect (Array.unsafe-nth declared i)]
          (do
            (append-effect-site! effects effect context id source provenance)
            (match-ref effect
              (CoreMemoryEffect.Unknown)
                (append-unresolved! unresolved context id source
                                    unknown-reason provenance)
              _ ()))))))

  (private source-memory-for)
  (hidden source-memory-for)
  (defn source-memory-for [specialized reference signature]
    (let-do [result (the (Maybe CoreMemoryManifest) (Maybe.Nothing))
             primitives (SpecializationModule.primitives specialized)]
      (for [i 0 (Array.length primitives)]
        (let [primitive (Array.unsafe-nth primitives i)
              specialization (SpecializedPrimitive.specialization primitive)]
          (when (and
              (CoreIR.same-ref? (Specialization.reference specialization)
                                reference)
              (Type.same-representation?
                (Box.peek (Specialization.signature specialization))
                signature))
            (match-ref (SpecializedPrimitive.source primitive)
              (Maybe.Just source)
                (match-ref (SpecializedBuiltinSource.payload source)
                  (CoreBuiltinPayload.External _ _ memory)
                    (set! result (Maybe.Just @memory))
                  (CoreBuiltinPayload.Template _ _ memory)
                    (set! result (Maybe.Just @memory)))
              (Maybe.Nothing) ()))))
      result))

  (private collect-summary!)
  (hidden collect-summary!)
  (private collect-summary-array!)
  (hidden collect-summary-array!)
  (private collect-summary-branches!)
  (hidden collect-summary-branches!)
  (sig collect-summary!
       (Fn [(Ref SpecializedExpr) (Ref SpecializationModule)
            (Ref CoreProvenance) Int (Ref (Array MemoryEffectSite))
            (Ref (Array MemoryCallEdge)) (Ref (Array MemoryUnresolvedLeaf))] ()))
  (sig collect-summary-array!
       (Fn [(Ref (Array (Box SpecializedExpr))) (Ref SpecializationModule)
            (Ref CoreProvenance) Int (Ref (Array MemoryEffectSite))
            (Ref (Array MemoryCallEdge)) (Ref (Array MemoryUnresolvedLeaf))] ()))
  (sig collect-summary-branches!
       (Fn [(Ref (Array SpecializedMatchBranch)) (Ref SpecializationModule)
            (Ref CoreProvenance) Int (Ref (Array MemoryEffectSite))
            (Ref (Array MemoryCallEdge)) (Ref (Array MemoryUnresolvedLeaf))] ()))

  (defn collect-summary-array! [expressions specialized provenance context
                                effects calls unresolved]
    (for [i 0 (Array.length expressions)]
      (collect-summary! (Box.peek (Array.unsafe-nth expressions i))
                        specialized provenance context effects calls unresolved)))

  (defn collect-summary-branches! [branches specialized provenance context
                                   effects calls unresolved]
    (for [i 0 (Array.length branches)]
      (collect-summary!
        (Box.peek (SpecializedMatchBranch.body (Array.unsafe-nth branches i)))
        specialized provenance context effects calls unresolved)))

  (defn collect-summary! [expression specialized provenance context
                          effects calls unresolved]
    (match-ref expression
      (SpecializedExpr.ArrayLit id _ elements)
        (do
          (when-do (Int.> (Array.length elements) 0)
            (let [effect (CoreMemoryEffect.Allocate
                           (CoreMemoryExtent.ExactElements
                             (Array.length elements)))]
              (append-effect-site! effects &effect context @id
                                   "array-literal" provenance)))
          (collect-summary-array! elements specialized provenance context
                                  effects calls unresolved))
      (SpecializedExpr.GlobalCall id _ reference signature symbol arguments)
        (do
          (collect-summary-array! arguments specialized provenance context
                                  effects calls unresolved)
          (if (String.starts-with? symbol "_carp_closure_")
            (let [effect (CoreMemoryEffect.Allocate
                           (CoreMemoryExtent.Unknown))]
              (append-effect-site! effects &effect context @id
                                   "closure-environment" provenance))
            (let [target (summary-body-index
                           (SpecializationModule.bodies specialized)
                           reference
                           (Box.peek signature))]
              (if (Int.>= target 0)
                (Array.push-back! calls
                  (MemoryCallEdge.init
                    (OwnershipSite.init context @id)
                    target
                    (String.copy (CoreRef.name reference))
                    (CoreProvenance.node-span provenance @id)))
                (match (PrimitiveRegistry.memory-for reference)
                  (Maybe.Just manifest)
                    (append-manifest! &manifest context @id
                                      (CoreRef.name reference)
                                      "primitive-manifest-unknown" provenance
                                      effects unresolved)
                  (Maybe.Nothing)
                    (match (source-memory-for specialized reference
                              (Box.peek signature))
                      (Maybe.Just manifest)
                        (let [reason
                               (if (String.=
                                   (CoreMemoryManifest.evidence &manifest)
                                   "omitted")
                                 (String.copy "memory-contract-omitted")
                                 (String.copy "source-memory-contract-unknown"))]
                          (append-manifest! &manifest context @id
                                            (CoreRef.name reference) &reason
                                            provenance effects unresolved))
                      (Maybe.Nothing)
                        (append-unresolved! unresolved context @id
                                            (CoreRef.name reference)
                                            "unannotated-foreign-or-template"
                                            provenance)))))))
      (SpecializedExpr.Call id _ callee arguments)
        (do
          (collect-summary! (Box.peek callee) specialized provenance context
                            effects calls unresolved)
          (collect-summary-array! arguments specialized provenance context
                                  effects calls unresolved)
          (append-unresolved! unresolved context @id "<indirect>"
                              "indirect-call" provenance))
      (SpecializedExpr.Do _ _ expressions)
        (collect-summary-array! expressions specialized provenance context
                                effects calls unresolved)
      (SpecializedExpr.If _ _ condition then-branch else-branch)
        (do
          (collect-summary! (Box.peek condition) specialized provenance context
                            effects calls unresolved)
          (collect-summary! (Box.peek then-branch) specialized provenance context
                            effects calls unresolved)
          (collect-summary! (Box.peek else-branch) specialized provenance context
                            effects calls unresolved))
      (SpecializedExpr.Let _ _ _ value body)
        (do
          (collect-summary! (Box.peek value) specialized provenance context
                            effects calls unresolved)
          (collect-summary! (Box.peek body) specialized provenance context
                            effects calls unresolved))
      (SpecializedExpr.Set _ _ _ value)
        (collect-summary! (Box.peek value) specialized provenance context
                          effects calls unresolved)
      (SpecializedExpr.While _ _ condition body)
        (do
          (collect-summary! (Box.peek condition) specialized provenance context
                            effects calls unresolved)
          (collect-summary! (Box.peek body) specialized provenance context
                            effects calls unresolved))
      ;; Lambda bodies are separate computations, not effects of constructing a
      ;; non-capturing function value. Capturing construction is represented by
      ;; the `_carp_closure_` GlobalCall handled above.
      (SpecializedExpr.Lambda _ _ _ _) ()
      (SpecializedExpr.Match _ _ _ scrutinee branches)
        (do
          (collect-summary! (Box.peek scrutinee) specialized provenance context
                            effects calls unresolved)
          (collect-summary-branches! branches specialized provenance context
                                     effects calls unresolved))
      (SpecializedExpr.Annotation _ _ inner _)
        (collect-summary! (Box.peek inner) specialized provenance context
                          effects calls unresolved)
      (SpecializedExpr.StaticArrayLit _ _ elements)
        (collect-summary-array! elements specialized provenance context
                                effects calls unresolved)
      _ ()))

  (private summary-has-allocate?)
  (hidden summary-has-allocate?)
  (private summary-has-resize?)
  (hidden summary-has-resize?)
  (private summary-has-free?)
  (hidden summary-has-free?)
  (private summary-has-unknown?)
  (hidden summary-has-unknown?)
  (defn summary-has-allocate? [effects]
    (let-do [found false]
      (for [i 0 (Array.length effects)]
        (match-ref (MemoryEffectSite.effect (Array.unsafe-nth effects i))
          (CoreMemoryEffect.Allocate _) (set! found true)
          _ ()))
      found))
  (defn summary-has-resize? [effects]
    (let-do [found false]
      (for [i 0 (Array.length effects)]
        (match-ref (MemoryEffectSite.effect (Array.unsafe-nth effects i))
          (CoreMemoryEffect.Resize _ _ _) (set! found true)
          _ ()))
      found))
  (defn summary-has-free? [effects]
    (let-do [found false]
      (for [i 0 (Array.length effects)]
        (match-ref (MemoryEffectSite.effect (Array.unsafe-nth effects i))
          (CoreMemoryEffect.Free _) (set! found true)
          _ ()))
      found))
  (defn summary-has-unknown? [effects]
    (let-do [found false]
      (for [i 0 (Array.length effects)]
        (match-ref (MemoryEffectSite.effect (Array.unsafe-nth effects i))
          (CoreMemoryEffect.Unknown) (set! found true)
          _ ()))
      found))

  (doc specialized-summaries "computes the least fixed point of direct memory
effects over the specialized body call graph. Calls without a body or checked
primitive manifest and all indirect calls remain unresolved, so the analysis
can prove absence of effects only for a closed reachable system.")
  (defn specialized-summaries [specialized provenance]
    (let-do [bodies (SpecializationModule.bodies specialized)
             n (Array.length bodies)
             effect-sets (the (Array (Array MemoryEffectSite)) [])
             call-sets (the (Array (Array MemoryCallEdge)) [])
             unresolved-sets (the (Array (Array MemoryUnresolvedLeaf)) [])
             allocates (the (Array Bool) [])
             resizes (the (Array Bool) [])
             frees (the (Array Bool) [])
             unknown (the (Array Bool) [])]
      (for [i 0 n]
        (let-do [effects (the (Array MemoryEffectSite) [])
                 calls (the (Array MemoryCallEdge) [])
                 unresolved (the (Array MemoryUnresolvedLeaf) [])]
          (collect-summary! (Box.peek
                              (SpecializedBody.body
                                (Array.unsafe-nth bodies i)))
                            specialized provenance i
                            &effects &calls &unresolved)
          (Array.push-back! &effect-sets effects)
          (Array.push-back! &call-sets calls)
          (Array.push-back! &unresolved-sets unresolved)
          (Array.push-back! &allocates
                            (summary-has-allocate?
                              (Array.unsafe-nth &effect-sets i)))
          (Array.push-back! &resizes
                            (summary-has-resize?
                              (Array.unsafe-nth &effect-sets i)))
          (Array.push-back! &frees
                            (summary-has-free?
                              (Array.unsafe-nth &effect-sets i)))
          (Array.push-back! &unknown
                            (or
                              (Int.> (Array.length
                                      (Array.unsafe-nth &unresolved-sets i)) 0)
                              (summary-has-unknown?
                                (Array.unsafe-nth &effect-sets i))))))
      ;; Four monotone bits can cross at most n-1 call edges. n+1 rounds are a
      ;; deterministic fixed-point bound, including recursive components.
      (for [pass 0 (Int.+ n 1)]
        (for [i 0 n]
          (let [edges (Array.unsafe-nth &call-sets i)]
            (for [edge-index 0 (Array.length edges)]
              (let [target @(MemoryCallEdge.target
                              (Array.unsafe-nth edges edge-index))]
                (when (and (Int.>= target 0) (Int.< target n))
                  (do
                    (when @(Array.unsafe-nth &allocates target)
                      (Array.aset! &allocates i true))
                    (when @(Array.unsafe-nth &resizes target)
                      (Array.aset! &resizes i true))
                    (when @(Array.unsafe-nth &frees target)
                      (Array.aset! &frees i true))
                    (when @(Array.unsafe-nth &unknown target)
                      (Array.aset! &unknown i true)))))))))
      (let-do [summaries (the (Array SpecializedMemorySummary) [])]
        (for [i 0 n]
          (Array.push-back! &summaries
            (SpecializedMemorySummary.init
              @(SpecializedBody.specialization (Array.unsafe-nth bodies i))
              (Array.copy (Array.unsafe-nth &effect-sets i))
              (Array.copy (Array.unsafe-nth &call-sets i))
              (Array.copy (Array.unsafe-nth &unresolved-sets i))
              @(Array.unsafe-nth &allocates i)
              @(Array.unsafe-nth &resizes i)
              @(Array.unsafe-nth &frees i)
              @(Array.unsafe-nth &unknown i))))
        summaries))))
