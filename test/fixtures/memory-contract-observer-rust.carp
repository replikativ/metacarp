(system-include "memory-contract-observer.h")

(register observer-reset
  (Fn [] ()) "carp_memory_contract_reset" [] [])
(register observer-allocated?
  (Fn [] Bool) "carp_memory_contract_has_allocation" [] [])
(register observer-freed?
  (Fn [] Bool) "carp_memory_contract_has_free" [] [])

;; This assertion is intentionally false. The Rust allocator adapter must
;; report the implementation's effects through the shared C ABI.
(register rust-violates-declared-noeffect
  (Fn [] Int) "MemoryContractFixture_rust_violates_noeffect" [] [])

(defn main []
  (do
    (observer-reset)
    (ignore (rust-violates-declared-noeffect))
    (if (and (observer-allocated?) (observer-freed?)) 0 1)))
